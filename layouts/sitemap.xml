{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
  {{- /* Mirror the noindex condition in partials/head.html exactly: a page that
         renders <meta name="robots" content="noindex"> must never be submitted in
         a sitemap. Checking .Kind as well as .Params.noindex means a translation
         that is missing its front matter (and so inherits no noindex param) still
         gets excluded. */ -}}
  {{- if and (not .Params.noindex) (ne .Sitemap.Disable true) (not (in (slice "taxonomy" "term") .Kind)) }}
  {{- $lm := .Lastmod }}
  {{- if $lm.IsZero }}{{ with .GitInfo }}{{ $lm = .AuthorDate }}{{ end }}{{ end }}
  {{- if $lm.IsZero }}{{ with .File }}{{ with .FileInfo }}{{ $lm = .ModTime }}{{ end }}{{ end }}{{ end }}
  {{- if $lm.IsZero }}{{ $lm = now }}{{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ $lm.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}"/>
    {{- end }}
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
